<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"areaServed":{"name":"Riverside","@type":"City"},"email":"contact@geotechnicalengineering1.biz","name":"Geotechnicalengineering 1 Riverside","@id":"https://riverside.geotechnicalengineering1.biz/#org-d148","address":{"addressCountry":"USA","addressLocality":"Riverside","@type":"PostalAddress"},"url":"https://riverside.geotechnicalengineering1.biz/","geo":{"longitude":0.0,"@type":"GeoCoordinates","latitude":0.0},"@type":"LocalBusiness"},{"areaServed":{"name":"Riverside","@type":"City"},"description":"Direct shear test in Riverside for cohesive and granular soils. ASTM D3080, peak and residual friction angles. Laboratory accredited under ISO 17025.","name":"Direct Shear Test in Riverside — Geotechnical Strength Parameters for Design","serviceType":"Direct shear test","provider":{"@id":"https://riverside.geotechnicalengineering1.biz/#org-d148"},"@id":"https://riverside.geotechnicalengineering1.biz/direct-shear/#service-d148","url":"https://riverside.geotechnicalengineering1.biz/direct-shear/","@type":"Service"},{"isPartOf":{"@id":"https://riverside.geotechnicalengineering1.biz/#website-d148"},"name":"Direct Shear Test in Riverside — Geotechnical Strength Parameters for Design","@id":"https://riverside.geotechnicalengineering1.biz/direct-shear/","url":"https://riverside.geotechnicalengineering1.biz/direct-shear/","inLanguage":"en","about":{"@id":"https://riverside.geotechnicalengineering1.biz/direct-shear/#service-d148"},"@type":"WebPage"},{"name":"Riverside","@id":"https://riverside.geotechnicalengineering1.biz/#website-d148","url":"https://riverside.geotechnicalengineering1.biz/","inLanguage":"en","@type":"WebSite"},{"@id":"https://riverside.geotechnicalengineering1.biz/direct-shear/#faq-74ef","mainEntity":[{"name":"What is the difference between direct shear and triaxial test for Riverside soils?","acceptedAnswer":{"text":"Direct shear forces failure along a pre-determined horizontal plane, which makes it faster and cheaper. Triaxial tests allow pore pressure measurement and failure along the weakest plane. For Riverside's alluvial clays, we recommend direct shear for preliminary design and triaxial for final verification on critical structures.","@type":"Answer"},"@type":"Question"},{"name":"How much does a direct shear test cost in Riverside?","acceptedAnswer":{"text":"A standard direct shear test with one normal stress stage costs between $650 and $810 per sample. Multi-stage or residual tests add $150–$300 depending on the number of cycles. Volume discounts apply for projects requiring more than ten samples.","@type":"Answer"},"@type":"Question"},{"name":"Can direct shear test results be used for seismic design in Riverside?","acceptedAnswer":{"text":"Yes, but only for the drained strength component. For seismic loading, you need cyclic triaxial or simple shear tests to capture pore pressure build-up. We use direct shear to define the baseline drained envelope and then apply ASCE 7-16 site class adjustments.","@type":"Answer"},"@type":"Question"},{"name":"What sample quality is required for a reliable direct shear test?","acceptedAnswer":{"text":"Undisturbed thin-wall tube samples (Shelby tubes) are preferred. For granular soils, we can use compacted remolded samples at target density and moisture content. Disturbed bag samples are not acceptable. The sample must have a diameter at least five times the maximum particle size.","@type":"Answer"},"@type":"Question"}],"@type":"FAQPage"}]}</script> <style>/*afx*/@media(max-width:900px){.nav{display:none}}
