<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"areaServed":{"name":"Riverside","@type":"City"},"email":"contact@geotechnicalengineering1.biz","name":"Geotechnicalengineering 1 Riverside","@id":"https://riverside.geotechnicalengineering1.biz/#org-d148","address":{"addressCountry":"USA","addressLocality":"Riverside","@type":"PostalAddress"},"url":"https://riverside.geotechnicalengineering1.biz/","geo":{"longitude":0.0,"@type":"GeoCoordinates","latitude":0.0},"@type":"LocalBusiness"},{"areaServed":{"name":"Riverside","@type":"City"},"description":"Technical seismic tomography services in Riverside, CA. Refraction and reflection surveys for geotechnical characterization, seismic hazard analysis, and foundation design. ASCE 7, IBC, ASTM compliant","name":"Seismic Tomography in Riverside: Refraction and Reflection Imaging for Subsurface Assessment","serviceType":"Seismic tomography (refraction/reflection)","provider":{"@id":"https://riverside.geotechnicalengineering1.biz/#org-d148"},"@id":"https://riverside.geotechnicalengineering1.biz/refraction-reflection/#service-d148","url":"https://riverside.geotechnicalengineering1.biz/refraction-reflection/","@type":"Service"},{"isPartOf":{"@id":"https://riverside.geotechnicalengineering1.biz/#website-d148"},"name":"Seismic Tomography in Riverside: Refraction and Reflection Imaging for Subsurface Assessment","@id":"https://riverside.geotechnicalengineering1.biz/refraction-reflection/","url":"https://riverside.geotechnicalengineering1.biz/refraction-reflection/","inLanguage":"en","about":{"@id":"https://riverside.geotechnicalengineering1.biz/refraction-reflection/#service-d148"},"@type":"WebPage"},{"name":"Riverside","@id":"https://riverside.geotechnicalengineering1.biz/#website-d148","url":"https://riverside.geotechnicalengineering1.biz/","inLanguage":"en","@type":"WebSite"},{"@id":"https://riverside.geotechnicalengineering1.biz/refraction-reflection/#faq-74ef","mainEntity":[{"name":"How deep can seismic tomography image in Riverside's alluvial soils?","acceptedAnswer":{"text":"Typical surveys reach 15-30 m with a sledgehammer source and up to 50 m with an accelerated weight-drop or small explosive charge. Depth depends on spread length, source energy, and ambient noise levels. Near the Santa Ana River, we often achieve 25-35 m penetration in saturated sands.","@type":"Answer"},"@type":"Question"},{"name":"What is the difference between refraction and reflection tomography?","acceptedAnswer":{"text":"Refraction tomography uses first-arrival travel times to invert for velocity structure, best for detecting velocity contrasts and bedrock depth. Reflection tomography processes reflected wave arrivals (CMP method) to image stratigraphic boundaries and fault zones with higher vertical resolution. We recommend both when fine layering or structural detail is critical.","@type":"Answer"},"@type":"Question"},{"name":"What is the typical cost range for a seismic tomography survey in Riverside?","acceptedAnswer":{"text":"For a standard 24-channel survey covering 100-200 linear meters, the cost ranges between US$2,610 and US$5,410. Larger spreads, multiple profiles, or reflection processing increase the scope. Contact us for a site-specific quote based on your project requirements.","@type":"Answer"},"@type":"Question"},{"name":"How does seismic tomography data feed into ASCE 7 site class classification?","acceptedAnswer":{"text":"The Vs30 value (average shear-wave velocity in the upper 30 meters) derived from tomography profiles directly determines Site Class A through F per ASCE 7-22. In Riverside, we commonly map Class C (360-760 m/s) and Class D (180-360 m/s) zones. The continuous velocity model also identifies anomalies that could trigger Site Class F if liquefaction or soft clay is present.","@type":"Answer"},"@type":"Question"}],"@type":"FAQPage"}]}</script> <style>/*afx*/@media(max-width:900px){.nav{display:none}}
