attribution:"&copy; OpenStreetMap contributors &copy; CARTO",maxZoom:19,subdomains:"abcd"
}).addTo(m);
L.marker([33.9824949,-117.374238],{icon:L.divIcon({html:'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 36\" width=\"24\" height=\"36\"><path d=\"M12 0C5.4 0 0 5.4 0 12c0 9 12 24 12 24s12-15 12-24c0-6.6-5.4-12-12-12z\" fill=\"#E11D48\" stroke=\"#FFF\" stroke-width=\"1.5\"/><circle cx=\"12\" cy=\"12\" r=\"4\" fill=\"#FFF\"/></svg>',className:'',iconSize:[24,36],iconAnchor:[12,36],popupAnchor:[0,-32]})}).addTo(m).bindPopup("Riverside");
})();
</script><div style="margin-top:.5rem;font-size:.78rem;color:#888;text-align:center"><a href="https://www.openstreetmap.org/?mlat=33.9824949&mlon=-117.374238#map=11/33.9824949/-117.374238" target="_blank" rel="noopener">Location and service area</a></div></div></section><footer style="background:linear-gradient(135deg,#1C1917,#D9770622);color:#FFF;padding:3rem 1.5rem"><div style="max-width:720px;margin:0 auto;text-align:center"><h3 style="font-size:1.4rem;margin:0 0 .5rem;color:#FFF">Ready for your project?</h3><p style="margin:0 0 1.5rem;color:rgba(255,255,255,.8)">Riverside, USA</p><a href="mailto:contact@geotechnicalengineering1.biz" style="display:inline-block;background:#D97706;color:#FFF !important;padding:.9rem 2.2rem;border-radius:8px;text-decoration:none;font-weight:700;font-size:1rem;box-shadow:0 4px 14px rgba(0,0,0,.25)">Request a quote — contact@geotechnicalengineering1.biz</a><p style="margin:1.8rem 0 0;font-size:.82rem;color:rgba(255,255,255,.5)">© 2026 Geotechnicalengineering1 · All rights reserved</p></div><div data-updated="2026-05-11" style="font-size:.78rem;color:rgba(255,255,255,.6);margin-top:.8rem">Last updated: 2026-05-11</div><div data-authority-refs class="authority-refs" style="text-align:center;font-size:.8rem;padding:.5rem 0;opacity:.6"><strong>References:</strong><a href="https://www.astm.org/products-services/standards-and-publications.html" rel="nofollow noopener" target="_blank">ASTM Standards</a> · <a href="https://www.publications.usace.army.mil/USACE-Publications/Engineer-Manuals/" rel="nofollow noopener" target="_blank">USACE Engineer Manuals</a> · <a href="https://www.iso.org/committee/49802.html" rel="nofollow noopener" target="_blank">ISO Geotechnical</a></div></footer><script>(function(){
// Dropdown click toggle
document.querySelectorAll(".nav-item.has-dd .nav-arrow").forEach(function(b){
b.addEventListener("click",function(e){
e.preventDefault();e.stopPropagation();
var p=b.parentElement;
var wasOpen=p.classList.contains("open");
document.querySelectorAll(".nav-item.has-dd.open").forEach(function(o){o.classList.remove("open");});
if(!wasOpen)p.classList.add("open");
});
});
document.addEventListener("click",function(e){
if(!e.target.closest(".nav-item.has-dd"))document.querySelectorAll(".nav-item.has-dd.open").forEach(function(o){o.classList.remove("open");});
});
// CONTATO clipboard copy
document.querySelectorAll(".cta-btn[data-email]").forEach(function(b){
b.addEventListener("click",function(e){
e.preventDefault();
var em=b.getAttribute("data-email");
navigator.clipboard.writeText(em).then(function(){
var orig=b.textContent;
b.textContent="Email copied";
b.style.background="#16A34A";
setTimeout(function(){b.textContent=orig;b.style.background="";},2000);
});
});
});
})();</script></body></html>